---
import IconHash from "@/assets/icons/IconHash.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";


const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.tagsTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.tagsTitle}>
    <ul class="flex flex-wrap gap-6">
      <li class="flex items-center gap-0.5 border-foreground border-b-2 border-dashed text-lg">
        <IconHash class="size-5 opacity-80" aria-hidden="true" />
        FastAPI
      </li>
    </ul>
  </Main>

  <Footer />
</Layout>
