---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" lang="zh-CN" class="notebook">
      <h1>学习笔记</h1>
      <p>QiJie 的个人笔记本</p>
      <div class="actions">
        <a href={getRelativeLocaleUrl(locale, "posts")}>浏览全部笔记 <IconArrowRight /></a>
        <a href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}><IconRss /> RSS 订阅</a>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            精选笔记
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            近期更新
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        全部笔记
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>

<style>
  .notebook {
    margin-top: 1.5rem;
    padding: clamp(2rem, 6vw, 4rem);
    border-radius: 1rem;
    color: #fffaf0;
    background-color: #234b42;
    background-image: linear-gradient(90deg, transparent 94%, #ffffff0c 94%),
      repeating-linear-gradient(0deg, transparent 0 31px, #ffffff0b 31px 32px);
    border-inline-start: 8px solid #16382f;
  }
  .notebook h1 { font: 650 clamp(2.6rem, 8vw, 4.5rem)/1.2 Georgia, "Songti SC", SimSun, serif; letter-spacing: .06em; }
  .notebook p { margin-top: .65rem; color: #dce9db; }
  .actions { margin-top: 2rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1.35rem; }
  .actions a { display: inline-flex; align-items: center; gap: .5rem; padding-block: .65rem; }
  .actions a:first-child { background: #fbf3df; color: #234b42; padding-inline: 1rem; border-radius: .3rem; }
  .actions a:hover { text-decoration: underline; text-underline-offset: .25em; }
  .actions :global(svg) { width: 1rem; height: 1rem; }
  #featured ul { display: grid; gap: 1rem; margin-top: 1rem; }
  #featured :global(li) { margin: 0; padding: 1.25rem; border: 1px solid var(--color-border); border-radius: .65rem; }
  #recent-posts :global(li) { padding-bottom: 1.4rem; border-bottom: 1px solid var(--color-border); }
  @media (min-width: 640px) { #featured ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>